        <assertj.version>3.27.7</assertj.version>
        <mockito.version>5.14.2</mockito.version>
        <testcontainers.version>1.20.3</testcontainers.version>
        <awaitility.version>4.2.2</awaitility.version>

        <!-- 插件版本 -->
        <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
        <maven-source-plugin.version>3.3.1</maven-source-plugin.version>
        <maven-javadoc-plugin.version>3.11.1</maven-javadoc-plugin.version>
        <maven-jar-plugin.version>3.4.2</maven-jar-plugin.version>
        <maven-surefire-plugin.version>3.5.2</maven-surefire-plugin.version>
        <maven-failsafe-plugin.version>3.5.2</maven-failsafe-plugin.version>
        <maven-enforcer-plugin.version>3.5.0</maven-enforcer-plugin.version>
        <jacoco-maven-plugin.version>0.8.12</jacoco-maven-plugin.version>
        <spotless-maven-plugin.version>2.43.0</spotless-maven-plugin.version>
        <owasp-dependency-check.version>12.1.1</owasp-dependency-check.version>
        <!-- OWASP Dependency-Check 默认跳过；CI 中通过 -Dowasp.skip=false 显式开启 -->
        <owasp.skip>true</owasp.skip>

        <!-- E-03：CycloneDX SBOM 插件。默认 true（跳过）以免影响本地构建；
             CI 的 sbom-scan job 用 -Dcyclonedx.skip=false 显式开启，
             生成聚合 SBOM（根 target/bom.json）后交给 osv-scanner 做无需密钥的 CVE 硬门禁。 -->
        <cyclonedx-maven-plugin.version>2.9.1</cyclonedx-maven-plugin.version>
        <cyclonedx.skip>true</cyclonedx.skip>

        <!-- Central Portal 发布插件 -->
        <central-publishing-maven-plugin.version>0.11.0</central-publishing-maven-plugin.version>

        <!-- API 兼容性检查（japicmp）：
             0.1.2 是首个公开版本（也是首个发布到 Maven Central 的版本）、无 previous 基线，
             默认跳过（japicmp.skip=true）；发布流程中由 release.yml 自动探测 Central 上的上一版本并临时覆盖启用 -->
        <japicmp-maven-plugin.version>0.26.1</japicmp-maven-plugin.version>
        <japicmp.skip>true</japicmp.skip>
        <japicmp.oldVersion/>

        <!-- JaCoCo 覆盖率门禁：默认跳过（避免本地开发/分支构建被覆盖率卡住），
             CI 的 coverage job 显式 -Djacoco.check.skip=false 启用（仅针对发布模块） -->
        <jacoco.check.skip>true</jacoco.check.skip>

        <!-- P0：@{} 占位符兜底（发布前必修）。
             surefire / failsafe 的 argLine 通过 @{jacoco.argLine} 做「延迟绑定」：
             该语法在 fork JVM 前才从 Maven 属性求值，且**未定义时不报错、原样透传**。
             jacoco 插件只声明在 pluginManagement、由各子模块按需引入，
             因此 streammq-test / streammq-samples/* / streammq-benchmark 等未引入 jacoco 的模块
             会把字面量 "@{jacoco.argLine}" 当作 JVM 参数传给 java，导致：
                 The forked VM terminated without properly saying goodbye（Tests run: 0，BUILD FAILURE）
             在此声明空默认值即可让未启用 jacoco 的模块解析为空串；启用 jacoco 的模块由
             prepare-agent 在运行时覆盖该属性（propertyName=jacoco.argLine），两者不冲突。 -->
        <jacoco.argLine/>
    </properties>

    <!-- ========== 依赖统一管理（默认 provided，子模块按需引入）========== -->
    <dependencyManagement>
        <dependencies>
            <!-- C-02：Jackson BOM 必须声明在 **spring-boot-dependencies import 之前**。
                 Maven 对 dependencyManagement 采用「先声明者优先」，Spring Boot BOM 管理的
                 Jackson 也由 Boot BOM 管理；若本 import 排在 Boot BOM 之后，逐构件条目会被 Boot 的
                 管理值覆盖（依赖收敛后实际仍解析到 Boot 版本，GHSA-r7wm-3cxj-wff9 / GHSA-72hv-8253-57qq 不修复）。
                 放在最前可保证 Jackson 全家桶统一为 ${jackson.version}（2.21.4）。
                 下方逐构件条目与本 import 版本一致，保留作为显式文档。 -->
            <dependency>
                <groupId>com.fasterxml.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- 内部模块版本由 BOM 提供 -->
            <dependency>
                <groupId>io.github.streammq</groupId>
                <artifactId>streammq-bom</artifactId>
                <version>${streammq.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- 测试基础设施公共件（内部工具模块，已发布构件 streammq-test）。
                 其依赖以 test scope 提供，不会作为可传递运行时依赖引入下游应用；
                 同样会发布到 Maven Central（不可加入 excludeArtifacts）。 -->
