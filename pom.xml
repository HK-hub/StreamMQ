    <!-- ========== 属性 ========== -->
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <maven.compiler.release>21</maven.compiler.release>
        <java.version>21</java.version>

        <!-- E-11 可复现构建：固定产物时间戳（jar 内条目时间统一为该值）。
             **每次发布前必须更新为「发布日期的固定值」**（如 2026-09-18T00:00:00Z），
             该值变化即代表产物字节变化、需重新走发布流程；同一 commit 重复构建可复现。 -->
        <project.build.outputTimestamp>2026-09-18T00:00:00Z</project.build.outputTimestamp>

        <streammq.version>0.1.2</streammq.version>

        <!-- 依赖版本 -->
        <spring-boot.version>3.5.16</spring-boot.version>
        <redisson.version>3.52.0</redisson.version>
        <!-- Jackson：2.21.4（自 2.17.2 起修复 GHSA-r7wm-3cxj-wff9 与 GHSA-72hv-8253-57qq）。
             注意：spring-boot-dependencies 亦管理 Jackson，因此下方 dependencyManagement
             中 jackson-bom 的 import **必须声明在 Spring Boot BOM 之前**（Maven「先声明者优先」）。 -->
        <jackson.version>2.21.4</jackson.version>
        <slf4j.version>2.0.16</slf4j.version>
        <micrometer.version>1.15.12</micrometer.version>
        <!-- 安全基线覆盖（Boot BOM 不管理该构件）：commons-compress 经 testcontainers 传递，
             钉到已修复版本（R4-CVE 门禁的 shipped-closure 扫描输入）。 -->
        <commons-compress.version>1.27.1</commons-compress.version>
        <!-- 安全基线覆盖：Boot 3.5.16 管理的 Netty（4.1.135.Final）仍命中两条 High 公告
             （GHSA-c4c3-7fpv-j4q5 / GHSA-558v-64gr-wgg4），钉到 4.1 线已修复的 4.1.138.Final。
             同样必须先于 Spring Boot BOM 声明（Maven「先声明者优先」）。 -->
        <netty.version>4.1.138.Final</netty.version>
        <lombok.version>1.18.34</lombok.version>
        <!-- Apache Fory（原 Apache Fury）：1.1.0 起修复 CVE-2026-50076（类注册绕过）、
