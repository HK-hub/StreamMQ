        <flatbuffers.version>24.3.25</flatbuffers.version>
        <!-- SBE（Simple Binary Encoding）：sbe-tool 纯 Java 代码生成，agrona 为生成代码运行时 -->
        <agrona.version>1.17.1</agrona.version>
