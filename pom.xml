    <!-- ========== 构建配置 ========== -->
    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <release>${java.version}</release>
                        <parameters>true</parameters>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                        </annotationProcessorPaths>
                        <!-- 编译门禁：
                             · -Xlint:unchecked  类型安全类告警保持致命（该类别跨 JDK 稳定，能真实反映泛型误用）
                             · -Xlint:-deprecation  deprecation 告警随 JDK / 三方依赖版本升级波动（库方弃用
                                API 即触发），纳入致命集会让构建对依赖升级过于脆弱；弃用 API 由 API 审查与
                                CHANGELOG 门禁把关
                             · -Werror  其余默认开启的告警类别（如 rawtypes/path）仍为致命 -->
                        <compilerArgs>
                            <arg>-Xlint:unchecked,-deprecation</arg>
                            <arg>-Werror</arg>
                        </compilerArgs>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-source-plugin</artifactId>
                    <version>${maven-source-plugin.version}</version>
                    <executions>
                        <execution>
                            <id>attach-sources</id>
                            <goals><goal>jar-no-fork</goal></goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${maven-jar-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>${maven-javadoc-plugin.version}</version>
                    <configuration>
                        <doclint>none</doclint>
                        <charset>UTF-8</charset>
                        <encoding>UTF-8</encoding>
                        <docencoding>UTF-8</docencoding>
                        <failOnError>true</failOnError>
                    </configuration>
                    <executions>
                        <execution>
                            <id>attach-javadocs</id>
                            <goals><goal>jar</goal></goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                    <configuration>
                        <!-- F-11：单个 fork JVM 的硬超时（600s）。测试死锁/挂起时直接失败，
                             而不是把本地构建或 CI runner 拖到整体超时上限。 -->
                        <forkedProcessTimeoutInSeconds>600</forkedProcessTimeoutInSeconds>
                        <!-- @{jacoco.argLine} 由 jacoco prepare-agent 注入（见下方 jacoco 插件
                             propertyName 配置）；若直接写死字面量会覆盖 jacoco agent，
                             导致覆盖率数据永远为空。 -->
                        <!-- Mockito inline mock maker 需要显式 agent 挂载，否则在 JDK 21+  future release 中会失效。
                             agent 路径指向本地仓库中的 mockito-core jar，由 Maven 在 test-compile 阶段保证可用。 -->
                        <argLine>
                            @{jacoco.argLine}
                            -Xshare:off
                            -XX:+EnableDynamicAgentLoading
                            -javaagent:${settings.localRepository}/org/mockito/mockito-core/${mockito.version}/mockito-core-${mockito.version}.jar
                        </argLine>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>${maven-failsafe-plugin.version}</version>
                    <!-- 集成测试同样需要加载 jacoco agent（@{jacoco.argLine} 由 prepare-agent 注入），
                         否则 IT 全部不产生覆盖率数据，仅单测数据会低估真实覆盖。 -->
                    <configuration>
                        <!-- F-11：与 surefire 一致，单个 fork JVM 硬超时 600s（防 IT 死锁挂起） -->
                        <forkedProcessTimeoutInSeconds>600</forkedProcessTimeoutInSeconds>
                        <argLine>
                            @{jacoco.argLine}
                            -Xshare:off
                            -XX:+EnableDynamicAgentLoading
                            -javaagent:${settings.localRepository}/org/mockito/mockito-core/${mockito.version}/mockito-core-${mockito.version}.jar
                        </argLine>
                    </configuration>
                    <executions>
                        <execution>
                            <goals>
                                <goal>integration-test</goal>
                                <goal>verify</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>${maven-enforcer-plugin.version}</version>
                    <executions>
                        <execution>
                            <id>enforce-versions</id>
                            <goals><goal>enforce</goal></goals>
                            <configuration>
                                <rules>
                                    <requireJavaVersion>
                                        <version>[21,)</version>
                                    </requireJavaVersion>
                                    <requireMavenVersion>
                                        <version>[3.9,)</version>
                                    </requireMavenVersion>
                                    <banDuplicatePomDependencyVersions/>
                                    <dependencyConvergence/>
                                </rules>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco-maven-plugin.version}</version>
                    <!-- P3-13：覆盖率门禁。
                         设计：prepare-agent / report 对所有模块产出覆盖率数据与报告（skip=false）。
                         门禁 check 不在此统一配置——各发布模块在自己的 pom 中声明 check execution，
                         带「贴合实际覆盖率的阈值」（见各模块 <jacoco-maven-plugin> 的 check 执行）。
                         原因：不同模块单测覆盖差异极大（核心库 90%+，工具/脚手架模块 17%~36%），
                         统一阈值要么形同虚设、要么误伤脚手架模块。按模块设卡才是有意义的门禁。
                         check 统一受 jacoco.check.skip 控制：本地/普通构建默认跳过不设卡，
                         CI 用 -Djacoco.check.skip=false 启用（仅发布模块生效）。 -->
                    <executions>
                        <execution>
                            <id>prepare-agent</id>
                            <goals><goal>prepare-agent</goal></goals>
                            <configuration>
                                <skip>false</skip>
                                <!-- 注入到独立属性 jacoco.argLine，surefire 通过
                                     @{jacoco.argLine} 引用（见 surefire 配置），
                                     避免与 -Xshare:off 等 JVM 参数互相覆盖。 -->
                                <propertyName>jacoco.argLine</propertyName>
                            </configuration>
                        </execution>
                        <execution>
                            <id>report</id>
                            <phase>verify</phase>
                            <goals><goal>report</goal></goals>
                            <configuration>
                                <skip>false</skip>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
                <!-- API 兼容性检查（japicmp）。默认跳过；release.yml 在探测到上一发布版本时
                     覆盖 japicmp.skip=false 与 japicmp.oldVersion，对已发布模块做二进制/源码兼容门禁。
                     0.1.x 兼容策略：核心/发布模块（core/redisson/spring-boot-starter/test）的公开 API
                     由本门禁强制「二进制 + 源码」兼容；确需破坏性变更时走 CHANGELOG 的
                     Breaking Changes 流程并显式调整基线，而不是静默放宽门禁。
                     ignoreMissingOldVersion=false：上一版本解析不到时必须失败（插件默认 true 会
                     静默跳过 → 假绿，发布通道将无法发现 japicmp 根本没跑）。
                     注：历史上这里排除过 io.github.streammq.internal.*，但该包并不存在
                     （仓库内 0 处 package 声明），属死配置，已删除以保持诚实口径。 -->
                <plugin>
                    <groupId>com.github.siom79.japicmp</groupId>
                    <artifactId>japicmp-maven-plugin</artifactId>
                    <version>${japicmp-maven-plugin.version}</version>
                    <configuration>
                        <skip>${japicmp.skip}</skip>
                        <oldVersion>
                            <dependency>
                                <groupId>io.github.streammq</groupId>
                                <artifactId>${project.artifactId}</artifactId>
                                <version>${japicmp.oldVersion}</version>
                            </dependency>
                        </oldVersion>
                        <parameter>
                            <onlyModified>true</onlyModified>
                            <breakBuildOnBinaryIncompatibleModifications>true</breakBuildOnBinaryIncompatibleModifications>
                            <breakBuildOnSourceIncompatibleModifications>true</breakBuildOnSourceIncompatibleModifications>
                            <ignoreMissingClasses>true</ignoreMissingClasses>
                            <ignoreMissingOldVersion>false</ignoreMissingOldVersion>
                        </parameter>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>com.diffplug.spotless</groupId>
                    <artifactId>spotless-maven-plugin</artifactId>
                    <version>${spotless-maven-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.owasp</groupId>
                    <artifactId>dependency-check-maven</artifactId>
                    <version>${owasp-dependency-check.version}</version>
                    <configuration>
                        <failBuildOnCVSS>7</failBuildOnCVSS>
                        <!-- F-6：抑制清单必须用 ${maven.multiModuleProjectDirectory} 绝对路径。
                             相对路径按**各模块 basedir** 解析，而扫描命令是
                             `-pl streammq-bom,streammq-core,...`（不含根工程）——
                             子模块下不存在 owasp-suppressions.xml，相对路径永不解析、抑制清单静默失效。 -->
                        <suppressionFile>${maven.multiModuleProjectDirectory}/owasp-suppressions.xml</suppressionFile>
                    </configuration>
                    <executions>
                        <execution>
                            <goals>
                                <goal>check</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <!-- E-03：CycloneDX 聚合 SBOM（CVE 硬门禁的输入）。
                     默认跳过（cyclonedx.skip=true）以免影响本地构建；CI 的 sbom-scan job 以
                     `mvn -Dcyclonedx.skip=false org.cyclonedx:cyclonedx-maven-plugin:makeAggregateBom`
                     显式调用（该 goal 为 aggregator，产物落在 reactor 根的 target/bom.json）。
                     execution 绑定 package 阶段：若未来某个模块显式声明本插件，即在 package 产出 BOM。 -->
                <plugin>
                    <groupId>org.cyclonedx</groupId>
                    <artifactId>cyclonedx-maven-plugin</artifactId>
                    <version>${cyclonedx-maven-plugin.version}</version>
                    <configuration>
                        <skip>${cyclonedx.skip}</skip>
                    </configuration>
                    <executions>
                        <execution>
                            <id>make-aggregate-bom</id>
                            <phase>package</phase>
                            <goals>
                                <goal>makeAggregateBom</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <!-- E-12：CI/发布通道以「命令行目标」方式调用的插件必须显式 pin 版本，
                     否则 Maven 按「最新版」解析 —— 同一 commit 在不同时间可能跑到不同插件版本。
                     版本号 2026-09 已核实存在于 Maven Central（首次升级时请重新确认）。 -->
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>versions-maven-plugin</artifactId>
                    <version>2.18.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-help-plugin</artifactId>
                    <version>3.5.1</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-dependency-plugin</artifactId>
                    <version>3.8.1</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <configuration>
                    <rules>
                        <requireJavaVersion>
                            <version>[21,)</version>
                        </requireJavaVersion>
                        <requireMavenVersion>
                            <version>[3.9,)</version>
                        </requireMavenVersion>
                        <banDuplicatePomDependencyVersions/>
                        <dependencyConvergence/>
                    </rules>
                </configuration>
            </plugin>
            <plugin>
                <groupId>com.github.siom79.japicmp</groupId>
                <artifactId>japicmp-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>api-compat-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>cmp</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>spotless-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <java>
                        <googleJavaFormat>
                            <version>1.24.0</version>
                            <style>AOSP</style>
                            <reflowLongStrings>true</reflowLongStrings>
                            <formatJavadoc>true</formatJavadoc>
                        </googleJavaFormat>
                        <licenseHeader>
                            <content>
/*
 * Copyright 2026 StreamMQ Contributors (https://github.com/HK-hub/StreamMQ)
 *
 * Licensed under the MIT License.
 */
                            </content>
                            <delimiter>package</delimiter>
                        </licenseHeader>
                        <includes>
                            <include>src/main/java/**/*.java</include>
                            <include>src/test/java/**/*.java</include>
                        </includes>
                    </java>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.owasp</groupId>
                <artifactId>dependency-check-maven</artifactId>
                <executions>
                    <execution>
                        <id>owasp-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <failBuildOnCVSS>7</failBuildOnCVSS>
                    <!-- F-6：同上——相对路径按模块 basedir 解析，-pl 扫描（不含根工程）下永不解析；
                         用 ${maven.multiModuleProjectDirectory} 指向仓库根，保证抑制清单真实生效。 -->
                    <suppressionFile>${maven.multiModuleProjectDirectory}/owasp-suppressions.xml</suppressionFile>
                    <skip>${owasp.skip}</skip>
                </configuration>
            </plugin>
            <!-- 上传到 Maven Central Portal（server-id 对应 settings.xml / CI 凭据条目） -->
            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
                <version>${central-publishing-maven-plugin.version}</version>
                <extensions>true</extensions>
                <configuration>
                    <publishingServerId>central</publishingServerId>
                    <deploymentName>StreamMQ-${project.version}</deploymentName>
                    <!-- 首个版本先人工在 Portal 点 Publish，稳定后可改为 true 自动发布 -->
                    <autoPublish>false</autoPublish>
                    <waitUntil>validated</waitUntil>
                    <!-- 不发布到中央仓库的构件：
                         · streammq-samples*  示例工程（仅仓库内演示用）
                         · streammq-benchmark 压测工程
                         · streammq-kubernetes 实验性预览（无模块依赖、核心能力默认 no-op），
                                              待功能完整后再纳入发布，避免过早形成 API 兼容承诺。 -->
                    <excludeArtifacts>streammq-samples,streammq-sample-quickstart,streammq-sample-transaction,streammq-sample-tracing,streammq-sample-diagnostics,streammq-sample-interceptor,streammq-sample-orderly,streammq-sample-delay,streammq-sample-dlq,streammq-benchmark,streammq-kubernetes,streammq-tracing-opentelemetry,streammq-diagnostics,streammq-spring-cloud-stream-binder</excludeArtifacts>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <!-- ========== 仓库配置 ========== -->
    <repositories>
        <repository>
            <id>central</id>
            <url>https://repo.maven.apache.org/maven2</url>
            <releases><enabled>true</enabled></releases>
            <snapshots><enabled>false</enabled></snapshots>
        </repository>
    </repositories>

    <!-- ========== 发布 Profile：GPG 签名 ========== -->
    <profiles>
        <profile>
            <id>gpg</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.7</version>
                        <configuration>
                            <!-- 非交互签名（发布通道必需）：gpg 2.1+ 在无 tty 的 CI runner 上
                                 默认拒绝从 pinentry 取口令，必须显式 loopback，否则 sign 步骤直接失败、
                                 deploy 永不执行（autoPublish=false 之前就中断）。口令由
                                 `-Dgpg.passphrase="$MAVEN_GPG_PASSPHRASE"` 在 release.yml 显式传入。
                                 本地交互式 -Pgpg 仍可由 gpg-agent 正常提示。 -->
                            <gpgArguments>
                                <arg>--pinentry-mode</arg>
                                <arg>loopback</arg>
                            </gpgArguments>
                        </configuration>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
