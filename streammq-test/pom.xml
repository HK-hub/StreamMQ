<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.streammq</groupId>
        <artifactId>streammq-parent</artifactId>
        <version>0.1.2</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>streammq-test</artifactId>
    <name>StreamMQ Test Utilities</name>
    <description>StreamMQ 测试支持：容器化 Redis（Testcontainers，需 Docker daemon）、Redis 可用性探测、断言工具、Mock 工具、测试 Listener 等。请以 test scope 引入。</description>

    <!--
      依赖可见性约定（重要）：

      本模块随 Maven Central 发布，使用方以 test scope 引入。凡是 src/main/java 中测试工具类
      **运行时必然加载**的类型，其坐标必须是可传递的普通 compile 依赖；一旦标为 optional/provided，
      使用方会在运行期得到 NoClassDefFoundError，且无法通过补依赖自救。

      · 可传递（compile，非 optional）：streammq-core / slf4j-api / redisson
        （RedisAvailability、测试基类、断言/Mock/容器化 Redis 工具类均直接引用这些类型，必须可见）
      · 使用者自备（optional）：JUnit / AssertJ / Mockito / Awaitility / Testcontainers —— 测试框架
        版本由使用方决定，不强加；未使用 Docker 模式时也不需要 Testcontainers。
      · 使用者自备（optional）：streammq-redisson —— 不使用 Redisson 适配器的项目不应被引入该实现。
    -->
    <dependencies>
        <!-- StreamMQ Core：断言 / Mock / TestListener 工具类的签名与实现均直接引用 core 类型，必须可传递。 -->
        <dependency>
            <groupId>io.github.streammq</groupId>
            <artifactId>streammq-core</artifactId>
        </dependency>

        <!-- SLF4J：测试基类使用 Logger，运行时必需，必须可传递。 -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- Redisson：测试基类需要创建 RedissonClient，运行时必需，必须可传递。
             版本由 streammq-bom / spring-boot-dependencies 统一管理，不会与使用方冲突。 -->
        <dependency>
            <groupId>org.redisson</groupId>
            <artifactId>redisson</artifactId>
        </dependency>

        <!-- StreamMQ Redisson Adapter：**仅本模块的测试源码**使用（src/main 零引用，已核实），
             因此声明为 test scope —— 既保证本模块 IT 可编译，又不会把适配层写进已发布 POM 的
             编译期依赖面（此前 optional+compile 会让下游读 POM 时误判"需要适配层"）。 -->
        <dependency>
            <groupId>io.github.streammq</groupId>
            <artifactId>streammq-redisson</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- 以下依赖在本模块为 compile scope，因为 src/main/java 中的测试工具类（断言/ Mock / 容器化 Redis）需要使用；
             但标记为 optional，交由使用方按其项目版本自行引入。 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>compile</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>compile</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>compile</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>compile</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>compile</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>com.redis</groupId>
            <artifactId>testcontainers-redis</artifactId>
            <scope>compile</scope>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
            </plugin>
            <!-- 发布前修复 P2-2：此前本模块未声明 failsafe，导致 CoreRedisIntegrationIT（44 个集成测试）
                 永远以 *IT 命名被 surefire 忽略、又无 failsafe 接管，在本地与 CI 中均从未执行。
                 现声明后，mvn verify 会真正运行这批针对真实 Redis 的核心集成测试。
                 无 Redis 时 CoreRedisIntegrationIT 通过 Assumptions.assumeTrue 优雅跳过，不会破坏构建。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
            </plugin>
            <!-- E-06：本模块同样是「发布集」成员（Central 上以 test scope 提供），
                 必须纳入覆盖率红线，否则发布集内存在无覆盖门禁的模块。
                 阈值口径：按门禁命令实测校准「实测 − 3pt」= LINE 0.78 / BRANCH 0.39
                 （实测 LINE 0.815 / BRANCH 0.424，见 docs/REPORT.md 的验证证据），
                 与 core/redisson/starter 的设卡口径一致。
                 check 统一受 jacoco.check.skip 控制（默认 true 跳过，CI 显式 -Djacoco.check.skip=false 启用）。 -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals><goal>check</goal></goals>
                        <configuration>
                            <skip>${jacoco.check.skip}</skip>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.78</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.39</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
