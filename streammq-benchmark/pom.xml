<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.streammq</groupId>
        <artifactId>streammq-parent</artifactId>
        <version>0.1.2</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>streammq-benchmark</artifactId>
    <name>StreamMQ Benchmark</name>
    <description>StreamMQ JMH 基准测试：序列化性能、消息发送吞吐、消费吞吐等。</description>

    <!-- 基准测试模块不发布到 Maven Central -->
    <properties>
        <maven.deploy.skip>true</maven.deploy.skip>
        <jmh.version>1.37</jmh.version>
        <!-- 基准运行时属性默认值：exec:exec 的子进程不会自动继承 mvn -D 参数，
             通过下方 <systemProperties> 插值透传；命令行 -D 可覆盖这些默认值。
             注意 fork/预热/测量参数不在这里：它们只由各 Benchmark 类注解决定（见 profile 注释）。 -->
        <streammq.redis.mode>docker</streammq.redis.mode>
        <streammq.redis.host>localhost</streammq.redis.host>
        <streammq.redis.port>6379</streammq.redis.port>
        <streammq.benchmark.allowFlush>false</streammq.benchmark.allowFlush>
        <!-- 消费基准：测量前预灌的积压条数（10KB 负载时约 500MB Redis 内存，按可用内存调整） -->
        <streammq.benchmark.backlog>50000</streammq.benchmark.backlog>
        <!-- 消费基准：低水位补货线程数（出现 INVALID 时优先加大） -->
        <streammq.benchmark.feederThreads>2</streammq.benchmark.feederThreads>
    </properties>

    <dependencies>
        <!-- StreamMQ Core -->
        <dependency>
            <groupId>io.github.streammq</groupId>
            <artifactId>streammq-core</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- StreamMQ Redisson Adapter -->
        <dependency>
            <groupId>io.github.streammq</groupId>
            <artifactId>streammq-redisson</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- StreamMQ Test Support -->
        <dependency>
            <groupId>io.github.streammq</groupId>
            <artifactId>streammq-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Redisson -->
        <dependency>
            <groupId>org.redisson</groupId>
            <artifactId>redisson</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Jackson -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Jackson JSR-310 时间模块：JacksonJsonSerializer 默认注册 JavaTimeModule，
             但 streammq-redisson 以 test scope 引入、不会传递其编译期依赖，需在此显式声明 -->
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Fory（原 Fury） -->
        <dependency>
            <groupId>org.apache.fory</groupId>
            <artifactId>fory-core</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- FlatBuffers（FlexBuffers 动态反射序列化，基准对比） -->
        <dependency>
            <groupId>com.google.flatbuffers</groupId>
            <artifactId>flatbuffers-java</artifactId>
            <version>24.3.25</version>
            <scope>test</scope>
        </dependency>

        <!-- SBE（Simple Binary Encoding）运行时：生成代码依赖 agrona -->
        <dependency>
            <groupId>org.agrona</groupId>
            <artifactId>agrona</artifactId>
            <version>1.17.1</version>
            <scope>test</scope>
        </dependency>

        <!-- Protostuff（运行时序列化，基准对比）。streammq-redisson 以 optional 声明，
             不会传递，需在此显式声明才能运行 ProtostuffSerializer 基准 -->
        <dependency>
            <groupId>io.protostuff</groupId>
            <artifactId>protostuff-core</artifactId>
            <version>1.8.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.protostuff</groupId>
            <artifactId>protostuff-runtime</artifactId>
            <version>1.8.0</version>
            <scope>test</scope>
        </dependency>

        <!-- JMH -->
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-core</artifactId>
            <version>${jmh.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-generator-annprocess</artifactId>
            <version>${jmh.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- 日志 -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- 测试 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.redis</groupId>
            <artifactId>testcontainers-redis</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.openjdk.jmh</groupId>
                            <artifactId>jmh-generator-annprocess</artifactId>
                            <version>${jmh.version}</version>
                        </path>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/*Test.java</include>
                    </includes>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            JMH 基准运行入口（CI benchmark.yml 采用同一组 exec 目标）。

            干净机器一条命令跑通（需 JDK 21 + Docker，docker 模式由 Testcontainers 拉起独占 Redis）：
              mvn -pl streammq-benchmark -am install -DskipTests   # 先把上游构件装进本地仓库
              mvn -Pbenchmark -pl streammq-benchmark test          # 全量三类基准，约 21 分钟

            也可单独触发某一组基准：
              mvn -Pbenchmark -pl streammq-benchmark exec:exec@benchmark-template
              mvn -Pbenchmark -pl streammq-benchmark exec:exec@benchmark-serialization
              mvn -Pbenchmark -pl streammq-benchmark exec:exec@benchmark-consumer

            参数真源（B4 修复：消除"注解一套、main() 里又覆盖一套"的双源）：
            1. fork/预热/测量只由各 Benchmark 类注解决定（main() 不再用 OptionsBuilder 覆盖）。
               当前默认值：Serialization / StreamMessageTemplate 为 @Fork(1) + @Warmup(2×1s)
               + @Measurement(3×2s)；StreamConsumer 为 @Fork(1) + @Warmup(1×2s) + @Measurement(3×3s)。
               全量默认运行约 21 分钟，上限预算 45 分钟由 BenchmarkBudgetTest 静态校验（超预算即红）。
               需要临时覆盖时用 JMH 命令行参数（-f/-wi/-i/-w/-r），不要再回到 main() 里覆盖。
            2. 系统性运行时属性只在本 profile 透传（exec:exec 不继承 mvn 命令行 -D），默认值见
               <properties>，命令行 -D 可覆盖：streammq.redis.mode/host/port、
               streammq.benchmark.backlog（消费基准预灌积压条数）、
               streammq.benchmark.feederThreads（低水位补货线程数）、
               streammq.benchmark.allowFlush（仅 local 模式需要）。
            3. 消费基准口径：测量前预灌积压、测量期间只做低水位补货（不持续补货），使消费端成为
               唯一瓶颈；若测量期间积压被耗尽（出现空读），该轮判 INVALID 并以非零码退出，并提示
               加大 -Dstreammq.benchmark.backlog。
            4. 必须用 exec:exec（真实子进程）而非 exec:java：JMH 的 @Fork 会基于 java.class.path
               启动 fork 进程，而 exec:java 在 Maven 进程内运行，fork 拿到的 classpath 不含
               jmh-core，会报 ForkedMain 类找不到。
            5. flushdb 守卫：docker 模式清空的是本进程独占容器（随机映射端口），自动放行；
               -Dstreammq.redis.mode=local 直连本地/共享 Redis 时必须追加
               -Dstreammq.benchmark.allowFlush=true 显式授权。
        -->
        <profile>
            <id>benchmark</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.1.0</version>
                        <configuration>
                            <classpathScope>test</classpathScope>
                        </configuration>
                        <executions>
                            <execution>
                                <id>benchmark-template</id>
                                <phase>test</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>java</executable>
                                    <arguments>
                                        <argument>-Djdk.attach.allowAttachSelf=true</argument>
                                        <argument>-Dstreammq.redis.mode=${streammq.redis.mode}</argument>
                                        <argument>-Dstreammq.redis.host=${streammq.redis.host}</argument>
                                        <argument>-Dstreammq.redis.port=${streammq.redis.port}</argument>
                                        <argument>-Dstreammq.benchmark.allowFlush=${streammq.benchmark.allowFlush}</argument>
                                        <argument>-classpath</argument>
                                        <classpath/>
                                        <argument>io.github.streammq.benchmark.StreamMessageTemplateBenchmark</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>benchmark-serialization</id>
                                <phase>test</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>java</executable>
                                    <arguments>
                                        <argument>-Dstreammq.redis.mode=${streammq.redis.mode}</argument>
                                        <argument>-Dstreammq.redis.host=${streammq.redis.host}</argument>
                                        <argument>-Dstreammq.redis.port=${streammq.redis.port}</argument>
                                        <argument>-Dstreammq.benchmark.allowFlush=${streammq.benchmark.allowFlush}</argument>
                                        <argument>-classpath</argument>
                                        <classpath/>
                                        <argument>io.github.streammq.benchmark.SerializationBenchmark</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>benchmark-consumer</id>
                                <phase>test</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>java</executable>
                                    <arguments>
                                        <argument>-Dstreammq.redis.mode=${streammq.redis.mode}</argument>
                                        <argument>-Dstreammq.redis.host=${streammq.redis.host}</argument>
                                        <argument>-Dstreammq.redis.port=${streammq.redis.port}</argument>
                                        <argument>-Dstreammq.benchmark.allowFlush=${streammq.benchmark.allowFlush}</argument>
                                        <argument>-Dstreammq.benchmark.backlog=${streammq.benchmark.backlog}</argument>
                                        <argument>-Dstreammq.benchmark.feederThreads=${streammq.benchmark.feederThreads}</argument>
                                        <argument>-classpath</argument>
                                        <classpath/>
                                        <argument>io.github.streammq.benchmark.StreamConsumerBenchmark</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>