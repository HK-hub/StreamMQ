<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.streammq</groupId>
        <artifactId>streammq-parent</artifactId>
        <version>0.1.1</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>streammq-benchmark</artifactId>
    <name>StreamMQ Benchmark</name>
    <description>StreamMQ JMH 基准测试：序列化性能、消息发送吞吐、消费吞吐等。</description>

    <!-- 基准测试模块不发布到 Maven Central -->
    <properties>
        <maven.deploy.skip>true</maven.deploy.skip>
        <jmh.version>1.37</jmh.version>
        <!-- 基准运行时属性默认值：exec:exec 的子进程不会自动继承 mvn -D 参数，
             通过下方 <systemProperties> 插值透传；命令行 -D 可覆盖这些默认值 -->
        <streammq.redis.mode>docker</streammq.redis.mode>
        <streammq.redis.host>localhost</streammq.redis.host>
        <streammq.redis.port>6379</streammq.redis.port>
        <streammq.benchmark.allowFlush>false</streammq.benchmark.allowFlush>
    </properties>

    <dependencies>
        <!-- StreamMQ Core -->
        <dependency>
            <groupId>io.github.streammq</groupId>
            <artifactId>streammq-core</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- StreamMQ Redisson Adapter -->
        <dependency>
            <groupId>io.github.streammq</groupId>
            <artifactId>streammq-redisson</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- StreamMQ Test Support -->
        <dependency>
            <groupId>io.github.streammq</groupId>
            <artifactId>streammq-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Redisson -->
        <dependency>
            <groupId>org.redisson</groupId>
            <artifactId>redisson</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Jackson -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Fury -->
        <dependency>
            <groupId>org.apache.fury</groupId>
            <artifactId>fury-core</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- JMH -->
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-core</artifactId>
            <version>${jmh.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-generator-annprocess</artifactId>
            <version>${jmh.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- 日志 -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- 测试 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.redis</groupId>
            <artifactId>testcontainers-redis</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.openjdk.jmh</groupId>
                            <artifactId>jmh-generator-annprocess</artifactId>
                            <version>${jmh.version}</version>
                        </path>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/*Test.java</include>
                    </includes>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            运行 JMH 基准：mvn -Pbenchmark -pl streammq-benchmark test
            基准耗时较长且默认通过 Testcontainers 启动 Redis（需 Docker），
            因此不绑定到默认生命周期，避免 mvn test / mvn verify 被劫持。

            也可单独触发某一组基准（CI benchmark.yml 采用此方式）：
            mvn -Pbenchmark -pl streammq-benchmark exec:exec@benchmark-template
            mvn -Pbenchmark -pl streammq-benchmark exec:exec@benchmark-serialization
            mvn -Pbenchmark -pl streammq-benchmark exec:exec@benchmark-consumer

            注意：
            1. 必须用 exec:exec（真实子进程）而非 exec:java：JMH 的 @Fork 会基于
               java.class.path 启动 fork 进程，而 exec:java 在 Maven 进程内运行，
               fork 拿到的 classpath 不含 jmh-core，会报 ForkedMain 类找不到。
            2. exec:exec 不会自动继承 mvn 命令行 -D 参数，因此子进程的命令行参数里
               显式透传了基准运行时属性（默认值见 pom <properties>，命令行 -D 可覆盖）：
               包括 streammq.redis.mode/host/port 与 streammq.benchmark.allowFlush。
            3. 基准准备/清理阶段含 flushdb，直连非独占 Redis 时必须追加
               -Dstreammq.benchmark.allowFlush=true 显式授权。
        -->
        <profile>
            <id>benchmark</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.1.0</version>
                        <configuration>
                            <classpathScope>test</classpathScope>
                        </configuration>
                        <executions>
                            <execution>
                                <id>benchmark-template</id>
                                <phase>test</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>java</executable>
                                    <arguments>
                                        <argument>-Djdk.attach.allowAttachSelf=true</argument>
                                        <argument>-Dstreammq.redis.mode=${streammq.redis.mode}</argument>
                                        <argument>-Dstreammq.redis.host=${streammq.redis.host}</argument>
                                        <argument>-Dstreammq.redis.port=${streammq.redis.port}</argument>
                                        <argument>-Dstreammq.benchmark.allowFlush=${streammq.benchmark.allowFlush}</argument>
                                        <argument>-classpath</argument>
                                        <classpath/>
                                        <argument>io.github.streammq.benchmark.StreamMessageTemplateBenchmark</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>benchmark-serialization</id>
                                <phase>test</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>java</executable>
                                    <arguments>
                                        <argument>-Dstreammq.redis.mode=${streammq.redis.mode}</argument>
                                        <argument>-Dstreammq.redis.host=${streammq.redis.host}</argument>
                                        <argument>-Dstreammq.redis.port=${streammq.redis.port}</argument>
                                        <argument>-Dstreammq.benchmark.allowFlush=${streammq.benchmark.allowFlush}</argument>
                                        <argument>-classpath</argument>
                                        <classpath/>
                                        <argument>io.github.streammq.benchmark.SerializationBenchmark</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>benchmark-consumer</id>
                                <phase>test</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>java</executable>
                                    <arguments>
                                        <argument>-Dstreammq.redis.mode=${streammq.redis.mode}</argument>
                                        <argument>-Dstreammq.redis.host=${streammq.redis.host}</argument>
                                        <argument>-Dstreammq.redis.port=${streammq.redis.port}</argument>
                                        <argument>-Dstreammq.benchmark.allowFlush=${streammq.benchmark.allowFlush}</argument>
                                        <argument>-classpath</argument>
                                        <classpath/>
                                        <argument>io.github.streammq.benchmark.StreamConsumerBenchmark</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>