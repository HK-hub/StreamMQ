<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- BOM 独立，不继承 streammq-parent，避免循环依赖 -->
    <groupId>io.github.streammq</groupId>
    <artifactId>streammq-bom</artifactId>
    <version>0.1.0</version>
    <packaging>pom</packaging>
    <name>StreamMQ BOM</name>
    <description>StreamMQ 物料清单 (Bill of Materials)，统一管理 StreamMQ 各模块与第三方依赖版本。本 BOM 独立于 streammq-parent，可被任意项目 import。</description>

    <properties>
        <!-- StreamMQ 自身版本 -->
        <streammq.version>0.1.0</streammq.version>

        <!-- 第三方依赖版本（与 streammq-parent 保持一致） -->
        <spring-boot.version>3.3.5</spring-boot.version>
        <redisson.version>3.34.1</redisson.version>
        <jackson.version>2.18.1</jackson.version>
        <slf4j.version>2.0.16</slf4j.version>
        <micrometer.version>1.13.6</micrometer.version>
        <lombok.version>1.18.34</lombok.version>
        <fury.version>0.9.0</fury.version>
        <protostuff.version>1.8.0</protostuff.version>
        <spring-cloud-stream.version>4.1.3</spring-cloud-stream.version>
        <spring-integration.version>6.3.4</spring-integration.version>
        <opentelemetry.version>1.40.0</opentelemetry.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Boot BOM -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- StreamMQ 自有模块 -->
            <dependency>
                <groupId>io.github.streammq</groupId>
                <artifactId>streammq-core</artifactId>
                <version>${streammq.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.streammq</groupId>
                <artifactId>streammq-redisson</artifactId>
                <version>${streammq.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.streammq</groupId>
                <artifactId>streammq-spring-boot-starter</artifactId>
                <version>${streammq.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.streammq</groupId>
                <artifactId>streammq-kubernetes</artifactId>
                <version>${streammq.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.streammq</groupId>
                <artifactId>streammq-tracing-opentelemetry</artifactId>
                <version>${streammq.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.streammq</groupId>
                <artifactId>streammq-diagnostics</artifactId>
                <version>${streammq.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.streammq</groupId>
                <artifactId>streammq-spring-cloud-stream-binder</artifactId>
                <version>${streammq.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.streammq</groupId>
                <artifactId>streammq-test</artifactId>
                <version>${streammq.version}</version>
            </dependency>

            <!-- 第三方依赖版本（覆盖 Spring Boot 默认） -->
            <dependency>
                <groupId>org.redisson</groupId>
                <artifactId>redisson</artifactId>
                <version>${redisson.version}</version>
            </dependency>
            <dependency>
                <groupId>org.redisson</groupId>
                <artifactId>redisson-spring-boot-starter</artifactId>
                <version>${redisson.version}</version>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-databind</artifactId>
                <version>${jackson.version}</version>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-core</artifactId>
                <version>${jackson.version}</version>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-annotations</artifactId>
                <version>${jackson.version}</version>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson.datatype</groupId>
                <artifactId>jackson-datatype-jsr310</artifactId>
                <version>${jackson.version}</version>
            </dependency>
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>${slf4j.version}</version>
            </dependency>
            <dependency>
                <groupId>io.micrometer</groupId>
                <artifactId>micrometer-core</artifactId>
                <version>${micrometer.version}</version>
            </dependency>
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
                <scope>provided</scope>
            </dependency>

            <!-- Apache Fury（高性能序列化） -->
            <dependency>
                <groupId>org.apache.fury</groupId>
                <artifactId>fury-core</artifactId>
                <version>${fury.version}</version>
            </dependency>

            <!-- Protostuff（Protocol Buffer 运行时序列化） -->
            <dependency>
                <groupId>io.protostuff</groupId>
                <artifactId>protostuff-core</artifactId>
                <version>${protostuff.version}</version>
            </dependency>
            <dependency>
                <groupId>io.protostuff</groupId>
                <artifactId>protostuff-runtime</artifactId>
                <version>${protostuff.version}</version>
            </dependency>

            <!-- Spring Cloud Stream -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-stream</artifactId>
                <version>${spring-cloud-stream.version}</version>
            </dependency>

            <!-- Spring Integration -->
            <dependency>
                <groupId>org.springframework.integration</groupId>
                <artifactId>spring-integration-core</artifactId>
                <version>${spring-integration.version}</version>
            </dependency>

            <!-- OpenTelemetry -->
            <dependency>
                <groupId>io.opentelemetry</groupId>
                <artifactId>opentelemetry-api</artifactId>
                <version>${opentelemetry.version}</version>
            </dependency>
            <dependency>
                <groupId>io.opentelemetry</groupId>
                <artifactId>opentelemetry-sdk</artifactId>
                <version>${opentelemetry.version}</version>
            </dependency>
            <dependency>
                <groupId>io.opentelemetry</groupId>
                <artifactId>opentelemetry-sdk-trace</artifactId>
                <version>${opentelemetry.version}</version>
            </dependency>
            <dependency>
                <groupId>io.opentelemetry</groupId>
                <artifactId>opentelemetry-exporter-otlp</artifactId>
                <version>${opentelemetry.version}</version>
            </dependency>
            <dependency>
                <groupId>io.opentelemetry</groupId>
                <artifactId>opentelemetry-semconv</artifactId>
                <version>${opentelemetry.version}-alpha</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

</project>
