<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.streammq</groupId>
    <artifactId>streammq-bom</artifactId>
    <!-- 和parent版本严格一致 -->
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>StreamMQ BOM</name>
    <description>StreamMQ 物料清单 (Bill of Materials)，统一管理 StreamMQ 各模块与依赖版本。</description>

    <!-- 这里直接可用 ${project.version} -->
    <properties>
        <streammq.version>${project.version}</streammq.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- StreamMQ 自有模块 -->
            <dependency>
                <groupId>io.github.streammq</groupId>
                <artifactId>streammq-core</artifactId>
                <version>${streammq.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.streammq</groupId>
                <artifactId>streammq-redisson-adapter</artifactId>
                <version>${streammq.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.streammq</groupId>
                <artifactId>streammq-spring-boot-starter</artifactId>
                <version>${streammq.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.streammq</groupId>
                <artifactId>streammq-native</artifactId>
                <version>${streammq.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.streammq</groupId>
                <artifactId>streammq-kafka-compat</artifactId>
                <version>${streammq.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.streammq</groupId>
                <artifactId>streammq-amqp-compat</artifactId>
                <version>${streammq.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.streammq</groupId>
                <artifactId>streammq-test</artifactId>
                <version>${streammq.version}</version>
            </dependency>

            <!-- 第三方依赖版本统一管理（覆盖父 BOM 的可选版本） -->
            <dependency>
                <groupId>org.redisson</groupId>
                <artifactId>redisson</artifactId>
                <version>${redisson.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

</project>
