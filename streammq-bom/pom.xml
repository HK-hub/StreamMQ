<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- BOM 独立，不继承 streammq-parent，避免循环依赖 -->
    <groupId>io.github.streammq</groupId>
    <artifactId>streammq-bom</artifactId>
    <version>0.1.1</version>
    <packaging>pom</packaging>
    <name>StreamMQ BOM</name>
    <description>StreamMQ 物料清单 (Bill of Materials)。管理 StreamMQ 全部发布构件与 Redisson 版本，并导入 spring-boot-dependencies 作为基线；不覆盖 Jackson / SLF4J / Micrometer / Spring Cloud 等与使用方业务强相关的第三方版本。本 BOM 独立于 streammq-parent，可被任意项目 import。</description>

    <url>https://github.com/HK-hub/StreamMQ</url>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>streammq-contributors</id>
            <name>StreamMQ Contributors</name>
            <email>3161880795@qq.com</email>
            <url>https://github.com/HK-hub/StreamMQ</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/HK-hub/StreamMQ.git</connection>
        <developerConnection>scm:git:https://github.com/HK-hub/StreamMQ.git</developerConnection>
        <url>https://github.com/HK-hub/StreamMQ</url>
        <tag>HEAD</tag>
    </scm>

    <!--
      BOM 的管理范围（有意保持克制）：

      · 管理：StreamMQ 自身全部发布构件 + redisson / redisson-spring-boot-starter
      · 管理：spring-boot-dependencies（提供使用方未显式引入时的基线版本）
      · **不**管理：Jackson / SLF4J / Micrometer / Fury / Protostuff / Spring Cloud Stream /
                    Spring Integration / OpenTelemetry

      为什么不管第三方传递依赖：BOM 的 import 顺序通常在使用方的 spring-boot-dependencies 之后，
      即 StreamMQ 的声明会**覆盖**使用方的版本。对 redisson 这是有意的（README 的快速开始片段
      省略了版本号，需要 BOM 兜底）；但对 Jackson 这类"用户大概率已在用、且与 StreamMQ 无关的"
      依赖，静默覆盖属于越权——用户会莫名其妙发现自己项目里的 Jackson 被换成了
      streammq-bom 指定的版本。这些版本交给使用方自己的 BOM 决定。
    -->
    <properties>
        <!-- StreamMQ 自身版本 -->
        <streammq.version>0.1.1</streammq.version>

        <!-- 由本 BOM 管理的第三方版本（与 streammq-parent 保持一致） -->
        <spring-boot.version>3.3.5</spring-boot.version>
        <redisson.version>3.34.1</redisson.version>
        <lombok.version>1.18.34</lombok.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Boot BOM -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- StreamMQ 自有模块 -->
            <dependency>
                <groupId>io.github.streammq</groupId>
                <artifactId>streammq-core</artifactId>
                <version>${streammq.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.streammq</groupId>
                <artifactId>streammq-redisson</artifactId>
                <version>${streammq.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.streammq</groupId>
                <artifactId>streammq-spring-boot-starter</artifactId>
                <version>${streammq.version}</version>
            </dependency>
            <!-- 注意：streammq-kubernetes 处于实验性阶段，被 release 流程的 excludeArtifacts 排除、
                 不会发布到 Maven Central。BOM 只管理实际发布的构件——若在此声明，使用方按版本号
                 依赖该模块时会解析到中央仓库中不存在的构件。待其纳入发布清单后再加入。 -->
            <dependency>
                <groupId>io.github.streammq</groupId>
                <artifactId>streammq-tracing-opentelemetry</artifactId>
                <version>${streammq.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.streammq</groupId>
                <artifactId>streammq-diagnostics</artifactId>
                <version>${streammq.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.streammq</groupId>
                <artifactId>streammq-spring-cloud-stream-binder</artifactId>
                <version>${streammq.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.streammq</groupId>
                <artifactId>streammq-test</artifactId>
                <version>${streammq.version}</version>
            </dependency>
            <!-- streammq-test-support 是 streammq-test 的运行时依赖，同样随版本发布，纳入 BOM 统一管理 -->
            <dependency>
                <groupId>io.github.streammq</groupId>
                <artifactId>streammq-test-support</artifactId>
                <version>${streammq.version}</version>
            </dependency>

            <!-- Redisson：README 的快速开始片段省略了版本号，依赖 BOM 兜底。
                 这是本 BOM 唯一主动覆盖的第三方传递依赖。 -->
            <dependency>
                <groupId>org.redisson</groupId>
                <artifactId>redisson</artifactId>
                <version>${redisson.version}</version>
            </dependency>
            <dependency>
                <groupId>org.redisson</groupId>
                <artifactId>redisson-spring-boot-starter</artifactId>
                <version>${redisson.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>2.43.0</version>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>enforce-versions</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <rules>
                        <requireJavaVersion>
                            <version>[21,)</version>
                        </requireJavaVersion>
                        <requireMavenVersion>
                            <version>[3.9,)</version>
                        </requireMavenVersion>
                        <banDuplicatePomDependencyVersions/>
                        <dependencyConvergence/>
                    </rules>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <!-- 发布走根 POM 的 central-publishing-maven-plugin（Central Portal），不再使用已停用的 OSSRH -->

    <!-- ========== 发布 Profile：GPG 签名 ========== -->
    <profiles>
        <profile>
            <id>gpg</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.7</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
