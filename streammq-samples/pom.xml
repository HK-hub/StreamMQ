<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.streammq</groupId>
        <artifactId>streammq-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>streammq-samples</artifactId>
    <packaging>pom</packaging>
    <name>StreamMQ Samples</name>
    <description>StreamMQ 示例聚合模块，含 QuickStart / 事务 / 延时 / 顺序 四个示例。</description>

    <modules>
        <module>streammq-sample-quickstart</module>
        <module>streammq-sample-transaction</module>
        <module>streammq-sample-delay</module>
        <module>streammq-sample-orderly</module>
    </modules>

    <dependencies>
        <!-- 示例公共依赖 -->
        <dependency>
            <groupId>io.github.streammq</groupId>
            <artifactId>streammq-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                    <executions>
                        <execution>
                            <goals>
                                <goal>repackage</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

</project>
